<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spotifake</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebClientMVC.styles.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script>
        window.onerror = function(message, source, lineno, colno, error) {
            alert("Error: " + message + "\nLine: " + lineno + "\nPlease send a screenshot of this to Antigravity.");
            return false;
        };
        window.addEventListener("unhandledrejection", function(event) {
            alert("Unhandled Promise Rejection: " + event.reason + "\nPlease send a screenshot of this to Antigravity.");
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsmediatags/3.9.5/jsmediatags.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
