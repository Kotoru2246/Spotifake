

--- VERSION ---

@{
    var dashType = ViewData["DashboardType"]?.ToString() ?? "artist";
    var currentPage = ViewData["CurrentPage"]?.ToString() ?? "";
    var backUrl = ViewData["BackUrl"]?.ToString() ?? "/";
    var backLabel = ViewData["BackLabel"]?.ToString() ?? "Back";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var pageEyebrow = ViewData["PageEyebrow"]?.ToString() ?? "Pages";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Spotifake</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="dash-body">
    <div class="dash-wrapper">
        <!-- Sidebar -->
        <aside class="dash-sidebar">
            <div class="dash-sidebar-brand">
                <h2>SPOTIFAKE</h2>
                <small>@(dashType == "admin" ? "Admin Control" : "Artist Manager")</small>
            </div>
            <nav class="dash-sidebar-nav">
                @if (dashType == "artist")
                {
                    <a href="/artist/manager" class="dash-sidebar-link @(currentPage == "dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                    <a href="/artist/manager/profile" class="dash-sidebar-link @(currentPage == "profile" ? "active" : "")">
                        <i class="bi bi-person-fill"></i> Edit Profile
                    </a>
                    <a href="/artist/manager/albums" class="dash-sidebar-link @(currentPage == "albums" ? "active" : "")">
                        <i class="bi bi-disc-fill"></i> Albums
                    </a>
                    <a href="/artist/manager/songs" class="dash-sidebar-link @(currentPage == "songs" ? "active" : "")">
                        <i class="bi bi-music-note-beamed"></i> Songs
                    </a>
                }
                else
                {
                    <a href="/admin/dashboard" class="dash-sidebar-link @(currentPage == "overview" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Overview
                    </a>
                    <a href="/admin/dashboard/users" class="dash-sidebar-link @(currentPage == "users" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> Users
                    </a>
                    <a href="/admin/dashboard/artists" class="dash-sidebar-link @(currentPage == "artists" ? "active" : "")">
                        <i class="bi bi-mic-fill"></i> Artists
                    </a>
                    <a href="/admin/dashboard/songs" class="dash-sidebar-link @(currentPage == "songs" ? "active" : "")">
                        <i class="bi bi-search"></i> Song Search
                    </a>
                    <a href="/admin/dashboard/requests" class="dash-sidebar-link @(currentPage == "requests" ? "active" : "")">
                        <i class="bi bi-clipboard-check-fill"></i> Artist Requests
                    </a>
                }
            </nav>
            <div class="dash-sidebar-footer">
                <a href="/" class="dash-sidebar-back">
                    <i class="bi bi-arrow-left"></i> Back to Player
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="dash-main">
            <!-- Top Bar -->
            <div class="dash-topbar">
                <div class="dash-topbar-left">
                    @if (!string.IsNullOrEmpty(backUrl) && backUrl != "/")
                    {
                        <a href="@backUrl" class="dash-back-btn">
                            <i class="bi bi-chevron-left"></i> @backLabel
                        </a>
                    }
                    <div class="dash-topbar-title">
                        <span class="dash-topbar-eyebrow">@pageEyebrow</span>
                        <h1 class="dash-topbar-heading">@pageTitle</h1>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="dash-content">
                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
