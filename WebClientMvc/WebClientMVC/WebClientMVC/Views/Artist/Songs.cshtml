@model DataAccess.Models.ArtistProfile
@{
    Layout = "_DashboardLayout";
    var songs = ViewBag.Songs as List<DataAccess.Models.Song> ?? new List<DataAccess.Models.Song>();
    var albums = ViewBag.Albums as List<DataAccess.Models.Album> ?? new List<DataAccess.Models.Album>();
    var search = ViewBag.Search as string;
}

<div class="dash-card">
    <div class="dash-card-header">
        <h3 class="dash-card-title">Song Manager</h3>
        <a href="/" class="dash-btn dash-btn-primary">
            <i class="bi bi-upload"></i> Upload New Song (Player)
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="dash-toast dash-toast-success">@TempData["SuccessMessage"]</div>
    }

    <!-- Search Bar -->
    <form method="get" action="/artist/manager/songs" class="dash-search-bar">
        <input type="text" name="search" class="dash-search-input" placeholder="Search songs by title..." value="@search" />
        <button type="submit" class="dash-btn dash-btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a href="/artist/manager/songs" class="dash-btn dash-btn-secondary">Clear</a>
        }
    </form>

    @if (songs.Any())
    {
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Album</th>
                    <th>Mood</th>
                    <th>Language</th>
                    <th>Streams</th>
                    <th>Uploaded</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var song in songs)
                {
                    <tr class="@(song.IsDeleted ? "is-deleted" : "")">
                        <td>
                            <strong>@song.Title</strong>
                            @if (!string.IsNullOrEmpty(song.Tags))
                            {
                                <br /><small style="color:var(--text-muted);">Genre: @song.Tags</small>
                            }
                        </td>
                        <td>@(song.AlbumEntity?.Title ?? "Single")</td>
                        <td>
                            <span class="dash-badge dash-badge-cyan">@(song.Mood ?? "Neutral")</span>
                        </td>
                        <td>@(song.Language ?? "en")</td>
                        <td>@song.PlayCount.ToString("N0")</td>
                        <td>@(song.UploadedAt?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                        <td>
                            @if (song.IsDeleted)
                            {
                                <span class="dash-badge dash-badge-red">Deleted</span>
                            }
                            else
                            {
                                <span class="dash-badge dash-badge-green">Active</span>
                            }
                        </td>
                        <td class="col-actions">
                            @if (!song.IsDeleted)
                            {
                                <button class="dash-btn dash-btn-secondary dash-btn-sm" onclick="editSong('@song.SongID', '@JavaScriptEncoder.Default.Encode(song.Title)', '@JavaScriptEncoder.Default.Encode(song.Mood ?? "")', '@JavaScriptEncoder.Default.Encode(song.Language ?? "")', '@JavaScriptEncoder.Default.Encode(song.Lyrics ?? "")', '@JavaScriptEncoder.Default.Encode(song.Credits ?? "")', '@(song.AlbumID?.ToString() ?? "")', '@JavaScriptEncoder.Default.Encode(song.CoverArtUrl ?? "")')">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form method="post" action="/artist/manager/songs/@song.SongID/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to soft-delete this song?');">
                                    <button type="submit" class="dash-btn dash-btn-danger dash-btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="dash-empty">
            <i class="bi bi-music-note-beamed"></i>
            <p>No songs found. Head over to the Player to upload songs!</p>
        </div>
    }
</div>

<!-- Modal: Edit Song -->
<div id="editSongModal" class="dash-modal-backdrop" style="display:none;">
    <div class="dash-modal" style="max-width: 650px;">
        <h3 class="dash-modal-title">Edit Song Details</h3>
        <form id="editSongForm" method="post">
            <div class="dash-form-row">
                <div class="dash-form-group">
                    <label class="dash-form-label">Song Title</label>
                    <input type="text" id="editSongTitle" name="title" class="dash-form-input" required />
                </div>
                <div class="dash-form-group">
                    <label class="dash-form-label">Album Assignment</label>
                    <select id="editSongAlbum" name="albumId" class="dash-form-select">
                        <option value="">-- Single (No Album) --</option>
                        @foreach (var alb in albums)
                        {
                            <option value="@alb.AlbumID">@alb.Title</option>
                        }
                    </select>
                </div>
            </div>

            <div class="dash-form-row">
                <div class="dash-form-group">
                    <label class="dash-form-label">Mood</label>
                    <select id="editSongMood" name="mood" class="dash-form-select">
                        <option value="happy">Happy</option>
                        <option value="energetic">Energetic</option>
                        <option value="calm">Calm</option>
                        <option value="sad">Sad</option>
                        <option value="angry">Angry</option>
                        <option value="neutral">Neutral</option>
                    </select>
                </div>
                <div class="dash-form-group">
                    <label class="dash-form-label">Language</label>
                    <input type="text" id="editSongLang" name="language" class="dash-form-input" placeholder="e.g. en, vi, ja" />
                </div>
            </div>

            <div class="dash-form-group">
                <label class="dash-form-label">Cover Art URL</label>
                <input type="url" id="editSongCover" name="coverArtUrl" class="dash-form-input" placeholder="https://example.com/cover.jpg" />
            </div>

            <div class="dash-form-group">
                <label class="dash-form-label">Lyrics</label>
                <textarea id="editSongLyrics" name="lyrics" class="dash-form-textarea" placeholder="Song lyrics..."></textarea>
            </div>

            <div class="dash-form-group">
                <label class="dash-form-label">Credits & Production Notes</label>
                <textarea id="editSongCredits" name="credits" class="dash-form-textarea" placeholder="Producer, songwriter, mixing credits..."></textarea>
            </div>

            <div class="dash-modal-actions">
                <button type="button" class="dash-btn dash-btn-secondary" onclick="closeModal('editSongModal')">Cancel</button>
                <button type="submit" class="dash-btn dash-btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }
        function editSong(id, title, mood, lang, lyrics, credits, albumId, cover) {
            document.getElementById('editSongForm').action = '/artist/manager/songs/' + id + '/update';
            document.getElementById('editSongTitle').value = title;
            document.getElementById('editSongMood').value = mood;
            document.getElementById('editSongLang').value = lang;
            document.getElementById('editSongLyrics').value = lyrics;
            document.getElementById('editSongCredits').value = credits;
            document.getElementById('editSongAlbum').value = albumId;
            document.getElementById('editSongCover').value = cover;
            openModal('editSongModal');
        }
    </script>
}
