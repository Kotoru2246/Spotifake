@{
    ViewData["Title"] = "Apply for Artist Account";
    Layout = "_Layout";
}

<div style="max-width: 600px; margin: 40px auto; padding: 32px; background: var(--bg-card, #111c44); border-radius: 20px; border: 1px solid rgba(255,255,255,0.06); color: #fff;">
    <h2 style="margin-bottom: 8px; font-size: 24px; font-weight: 700;">Artist Application</h2>
    <p style="color: #a0aec0; font-size: 14px; margin-bottom: 24px;">Apply to become a verified Spotifake Artist. Upload your CV and demo track for admin review.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: rgba(245,101,101,0.15); color: #f56565; padding: 12px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 20px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: rgba(29,185,84,0.15); color: #1db954; padding: 12px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 20px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <form method="post" action="/artist/register" enctype="multipart/form-data">
        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: #a0aec0;">Requested Stage Name *</label>
            <input type="text" name="stageName" required class="dash-form-input" placeholder="e.g. DJ Cool, Luna Star" style="width:100%; padding:12px; background:#0b1437; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff;" />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: #a0aec0;">Artist Bio / Pitch</label>
            <textarea name="bio" rows="4" class="dash-form-textarea" placeholder="Tell us about your music style, experience, and vision..." style="width:100%; padding:12px; background:#0b1437; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff;"></textarea>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: #a0aec0;">CV / Portfolio File (PDF, DOC, DOCX) *</label>
            <input type="file" name="cvFile" accept=".pdf,.doc,.docx" required style="width:100%; padding:10px; background:#0b1437; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff;" />
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: #a0aec0;">Demo Track Audio File (MP3, WAV) *</label>
            <input type="file" name="demoFile" accept="audio/*" required style="width:100%; padding:10px; background:#0b1437; border:1px solid rgba(255,255,255,0.1); border-radius:10px; color:#fff;" />
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
            <a href="/" style="color: #a0aec0; text-decoration: none; font-size: 14px;">Back to Player</a>
            <button type="submit" style="background: #1db954; color: #fff; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 600; cursor: pointer;">
                Submit Application
            </button>
        </div>
    </form>
</div>
