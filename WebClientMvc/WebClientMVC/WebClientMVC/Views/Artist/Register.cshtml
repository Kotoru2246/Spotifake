@{
    ViewData["Title"] = "Become an Artist";
}

<style>
    body {
        background-color: #000;
        color: #fff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .artist-register-container {
        max-width: 600px;
        margin: 5rem auto;
        background: rgba(24, 24, 24, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 4rem 3rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }
    .form-control {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }
    .form-control:focus {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: #1db954;
        color: #fff;
        box-shadow: 0 0 15px rgba(29, 185, 84, 0.3);
        outline: none;
    }
    .form-label {
        font-size: 0.75rem;
        color: #a7a7a7;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }
    .btn-spotify {
        background-color: #1db954;
        color: #000;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.5px;
        border-radius: 500px;
        padding: 14px 40px;
        border: none;
        box-shadow: 0 4px 15px rgba(29, 185, 84, 0.2);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
    }
    .btn-spotify:hover {
        background-color: #1ed760;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 25px rgba(29, 185, 84, 0.4);
        color: #000;
    }
    .btn-spotify:active {
        transform: translateY(1px) scale(0.98);
        box-shadow: 0 2px 10px rgba(29, 185, 84, 0.2);
    }
</style>

<div class="artist-register-container text-light">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="letter-spacing: -0.5px;">Become an Artist</h2>
        <p class="text-secondary">Share your music with the world. Apply for an artist profile below.</p>
    </div>

    <form action="/artist/register" method="post" enctype="multipart/form-data">
        <div class="mb-4">
            <label for="stageName" class="form-label fw-bold">Stage Name / Artist Name</label>
            <input type="text" class="form-control form-control-lg" id="stageName" name="stageName" required>
        </div>
        <div class="mb-4">
            <label for="bio" class="form-label fw-bold">Biography</label>
            <textarea class="form-control" id="bio" name="bio" rows="4" placeholder="Tell us a little bit about yourself..."></textarea>
        </div>
        <div class="mb-4">
            <label for="cvFile" class="form-label fw-bold">CV / Resume (PDF, DOC)</label>
            <input type="file" class="form-control" id="cvFile" name="cvFile" accept=".pdf,.doc,.docx">
            <small style="color: #666;">Upload your CV or resume for admin review.</small>
        </div>
        <div class="mb-4">
            <label for="demoFile" class="form-label fw-bold">Demo Track (MP3, WAV)</label>
            <input type="file" class="form-control" id="demoFile" name="demoFile" accept="audio/*">
            <small style="color: #666;">Upload a sample of your work.</small>
        </div>
        <div class="d-grid mt-5">
            <button type="submit" class="btn btn-spotify btn-lg">Submit Application</button>
        </div>
    </form>
</div>
