@model DataAccess.Models.ArtistProfile
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Stat Cards -->
<div class="dash-stats-grid">
    <div class="dash-stat-card">
        <div class="stat-icon green"><i class="bi bi-headphones"></i></div>
        <div class="stat-label">Total Streams</div>
        <div class="stat-value dash-number">@(((long)ViewBag.TotalStreams).ToString("N0"))</div>
    </div>
    <div class="dash-stat-card">
        <div class="stat-icon cyan"><i class="bi bi-music-note-beamed"></i></div>
        <div class="stat-label">Total Songs</div>
        <div class="stat-value dash-number">@ViewBag.TotalSongs</div>
    </div>
    <div class="dash-stat-card">
        <div class="stat-icon purple"><i class="bi bi-disc-fill"></i></div>
        <div class="stat-label">Total Albums</div>
        <div class="stat-value dash-number">@ViewBag.TotalAlbums</div>
    </div>
</div>

<!-- Recent Songs -->
<div class="dash-card">
    <div class="dash-card-header">
        <h3><i class="bi bi-clock-history"></i> Recent Uploads</h3>
        <a href="/artist/manager/songs" class="dash-btn dash-btn-secondary dash-btn-sm">View All</a>
    </div>
    <div class="dash-card-body no-pad">
        @{
            var recentSongs = (List<DataAccess.Models.Song>)ViewBag.RecentSongs;
        }
        @if (recentSongs != null && recentSongs.Any())
        {
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Genre</th>
                        <th>Mood</th>
                        <th>Streams</th>
                        <th>Uploaded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var song in recentSongs)
                    {
                        <tr>
                            <td><strong>@song.Title</strong></td>
                            <td><span class="dash-badge cyan">@(song.Tags ?? "analyzing...")</span></td>
                            <td><span class="dash-badge yellow">@(song.Mood ?? "—")</span></td>
                            <td class="dash-number">@song.PlayCount.ToString("N0")</td>
                            <td>@(song.UploadedAt?.ToString("MMM dd, yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="dash-empty">
                <i class="bi bi-music-note-list"></i>
                <p>No songs uploaded yet. Start by uploading your first track!</p>
            </div>
        }
    </div>
</div>
