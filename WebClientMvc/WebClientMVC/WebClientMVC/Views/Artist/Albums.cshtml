@model DataAccess.Models.ArtistProfile
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var albums = (List<DataAccess.Models.Album>)ViewBag.Albums;
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(29,185,84,0.15); border: 1px solid rgba(29,185,84,0.3); border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; color: #1db954;">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- Action Bar -->
<div class="dash-action-bar">
    <div class="dash-search-wrapper" style="flex: 1; max-width: 400px; margin-bottom: 0;">
        <i class="bi bi-search"></i>
        <input type="text" class="dash-search-input" id="albumSearch" placeholder="Search albums..." oninput="filterAlbumTable()">
    </div>
    <button class="dash-btn dash-btn-primary" onclick="document.getElementById('createAlbumModal').classList.add('show')">
        <i class="bi bi-plus-lg"></i> Create New Album
    </button>
</div>

<!-- Albums Table -->
<div class="dash-card">
    <div class="dash-card-body no-pad">
        @if (albums != null && albums.Any())
        {
            <table class="dash-table" id="albumTable">
                <thead>
                    <tr>
                        <th>Album Title</th>
                        <th>Description</th>
                        <th>Songs</th>
                        <th>Total Streams</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var album in albums)
                    {
                        var activeSongs = album.Songs?.Where(s => !s.IsDeleted).ToList() ?? new List<DataAccess.Models.Song>();
                        var totalStreams = album.Songs?.Sum(s => s.PlayCount) ?? 0;
                        <tr class="@(album.IsDeleted ? "deleted-row" : "")" data-name="@album.Title.ToLower()">
                            <td><strong>@album.Title</strong></td>
                            <td>@(string.IsNullOrEmpty(album.Description) ? "—" : album.Description.Length > 40 ? album.Description[..40] + "..." : album.Description)</td>
                            <td class="dash-number">@activeSongs.Count</td>
                            <td class="dash-number">@totalStreams.ToString("N0")</td>
                            <td>@album.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (album.IsDeleted)
                                {
                                    <span class="dash-badge red">Deleted</span>
                                }
                                else
                                {
                                    <span class="dash-badge green">Active</span>
                                }
                            </td>
                            <td>
                                @if (!album.IsDeleted)
                                {
                                    <button class="dash-btn-icon" title="Edit" onclick="openEditAlbum('@album.AlbumID', '@album.Title.Replace("'", "\\'")', '@(album.Description?.Replace("'", "\\'") ?? "")', '@album.CoverArtUrl')">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <form method="post" action="/artist/manager/albums/@album.AlbumID/delete" style="display: inline;" onsubmit="return confirm('Delete this album? All songs in it will also be hidden.')">
                                        <button type="submit" class="dash-btn-icon" title="Delete" style="color: var(--accent-red);">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/artist/manager/albums/@album.AlbumID/restore" style="display: inline;" onsubmit="return confirm('Restore this album? All songs in it will also be restored.')">
                                        <button type="submit" class="dash-btn-icon" title="Restore" style="color: var(--accent-green);">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="dash-empty">
                <i class="bi bi-disc"></i>
                <p>No albums yet. Create your first album!</p>
            </div>
        }
    </div>
</div>

<!-- Create Album Modal -->
<div class="dash-modal-overlay" id="createAlbumModal">
    <div class="dash-modal">
        <div class="dash-modal-header">
            <h3><i class="bi bi-plus-circle-fill"></i> Create New Album</h3>
            <button class="dash-modal-close" onclick="document.getElementById('createAlbumModal').classList.remove('show')">&times;</button>
        </div>
        <form method="post" action="/artist/manager/albums/create" enctype="multipart/form-data">
            <div class="dash-modal-body">
                <div class="dash-form-group">
                    <label class="dash-label">Album Title</label>
                    <input type="text" name="title" class="dash-input" required placeholder="Enter album name">
                </div>
                <div class="dash-form-group">
                    <label class="dash-label">Description</label>
                    <textarea name="description" class="dash-textarea" rows="3" placeholder="Describe this album..."></textarea>
                </div>
                <div class="dash-form-group">
                    <label class="dash-label">Cover Art URL</label>
                    <input type="url" name="coverArtUrl" class="dash-input" placeholder="https://...">
                </div>
                <div class="dash-form-group">
                    <label class="dash-label">Or Upload Cover Art</label>
                    <input type="file" name="coverArtFile" class="dash-input" accept="image/*">
                </div>
            </div>
            <div class="dash-modal-footer">
                <button type="button" class="dash-btn dash-btn-secondary" onclick="document.getElementById('createAlbumModal').classList.remove('show')">Cancel</button>
                <button type="submit" class="dash-btn dash-btn-primary"><i class="bi bi-plus-lg"></i> Create Album</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Album Modal -->
<div class="dash-modal-overlay" id="editAlbumModal">
    <div class="dash-modal">
        <div class="dash-modal-header">
            <h3><i class="bi bi-pencil-fill"></i> Edit Album</h3>
            <button class="dash-modal-close" onclick="document.getElementById('editAlbumModal').classList.remove('show')">&times;</button>
        </div>
        <form method="post" id="editAlbumForm">
            <div class="dash-modal-body">
                <div class="dash-form-group">
                    <label class="dash-label">Album Title</label>
                    <input type="text" name="title" id="editAlbumTitle" class="dash-input" required>
                </div>
                <div class="dash-form-group">
                    <label class="dash-label">Description</label>
                    <textarea name="description" id="editAlbumDesc" class="dash-textarea" rows="3"></textarea>
                </div>
                <div class="dash-form-group">
                    <label class="dash-label">Cover Art URL</label>
                    <input type="url" name="coverArtUrl" id="editAlbumCover" class="dash-input">
                </div>
            </div>
            <div class="dash-modal-footer">
                <button type="button" class="dash-btn dash-btn-secondary" onclick="document.getElementById('editAlbumModal').classList.remove('show')">Cancel</button>
                <button type="submit" class="dash-btn dash-btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function filterAlbumTable() {
    const q = document.getElementById('albumSearch').value.toLowerCase();
    document.querySelectorAll('#albumTable tbody tr').forEach(row => {
        row.style.display = row.dataset.name.includes(q) ? '' : 'none';
    });
}
function openEditAlbum(id, title, desc, cover) {
    document.getElementById('editAlbumForm').action = '/artist/manager/albums/' + id + '/update';
    document.getElementById('editAlbumTitle').value = title;
    document.getElementById('editAlbumDesc').value = desc;
    document.getElementById('editAlbumCover').value = cover || '';
    document.getElementById('editAlbumModal').classList.add('show');
}
</script>
}
