@model DataAccess.Models.ArtistProfile
@{
    Layout = "_DashboardLayout";
}

<div class="dash-card">
    <div class="dash-card-header">
        <h3 class="dash-card-title">Edit Artist Profile</h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="dash-toast dash-toast-success">@TempData["SuccessMessage"]</div>
    }

    <form method="post" action="/artist/manager/profile">
        <div class="dash-form-row">
            <div class="dash-form-group">
                <label class="dash-form-label">Stage Name</label>
                <input type="text" name="stageName" class="dash-form-input" value="@Model.StageName" required />
            </div>

            <div class="dash-form-group">
                <label class="dash-form-label">Genre / Style</label>
                <input type="text" class="dash-form-input" value="@Model.Genre" readonly style="opacity:0.6; cursor:not-allowed;" title="Set by system / songs" />
            </div>
        </div>

        <div class="dash-form-row">
            <div class="dash-form-group">
                <label class="dash-form-label">Date of Birth</label>
                <input type="date" name="dateOfBirth" class="dash-form-input" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="dash-form-group">
                <label class="dash-form-label">Nationality</label>
                <input type="text" name="nationality" class="dash-form-input" value="@Model.Nationality" placeholder="e.g. United States, Japan, Vietnam" />
            </div>
        </div>

        <div class="dash-form-group">
            <label class="dash-form-label">Profile Image URL</label>
            <input type="url" name="profileImageUrl" class="dash-form-input" value="@Model.ProfileImageUrl" placeholder="https://example.com/avatar.jpg" />
        </div>

        <div class="dash-form-group">
            <label class="dash-form-label">Official Website</label>
            <input type="url" name="website" class="dash-form-input" value="@Model.Website" placeholder="https://yourwebsite.com" />
        </div>

        <div class="dash-form-group">
            <label class="dash-form-label">Biography</label>
            <textarea name="bio" class="dash-form-textarea" placeholder="Tell your listeners about your musical journey...">@Model.Bio</textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:24px;">
            <a href="/artist/manager" class="dash-btn dash-btn-secondary">Cancel</a>
            <button type="submit" class="dash-btn dash-btn-primary">
                <i class="bi bi-check-lg"></i> Save Changes
            </button>
        </div>
    </form>
</div>
