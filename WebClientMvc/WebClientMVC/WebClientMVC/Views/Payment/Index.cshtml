@{
    ViewData["Title"] = "Spotifake Premium - Nâng cấp tài khoản";
}

<style>
    /* Reset & Shell styling specific to Payment page to guarantee crisp render */
    body {
        background-color: #0b0b0b !important;
        color: #ffffff !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        margin: 0;
        padding: 0;
    }

    .prem-page-shell {
        min-height: 100vh;
        background: radial-gradient(circle at top center, #1a2c20 0%, #0d120e 45%, #080a08 100%);
        padding: 28px 24px 80px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .prem-nav-header {
        width: 100%;
        max-width: 960px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 24px;
        margin-bottom: 36px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .prem-logo {
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .prem-logo span {
        color: #1ed760;
    }

    .prem-back-btn {
        background: transparent;
        color: #ffffff;
        border: 1px solid #727272;
        padding: 8px 20px;
        border-radius: 9999px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .prem-back-btn:hover {
        border-color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
        transform: scale(1.02);
        color: #ffffff;
    }

    /* Step 1 Comparison Cards Layout */
    .prem-title-headline {
        font-size: 40px;
        font-weight: 800;
        text-align: center;
        margin-top: 10px;
        margin-bottom: 40px;
        letter-spacing: -1px;
        color: #ffffff;
    }

    .prem-cards-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
        width: 100%;
        max-width: 920px;
        align-items: stretch;
    }

    .prem-card {
        background: #181818;
        border: 1px solid #2a2a2a;
        border-radius: 16px;
        padding: 36px 36px 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }

    .prem-card-highlight {
        background: linear-gradient(145deg, #1a291f 0%, #121613 100%);
        border: 2px solid #1ed760;
        box-shadow: 0 16px 40px rgba(30, 215, 96, 0.15);
    }

    .prem-card:hover {
        transform: translateY(-4px);
    }

    .prem-card-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 12px 0;
    }

    .prem-card-price {
        font-size: 42px;
        font-weight: 900;
        line-height: 1.1;
        color: #ffffff;
        margin: 4px 0 0 0;
    }

    .prem-card-price small {
        font-size: 16px;
        font-weight: 500;
        color: #a0a0a0;
    }

    .prem-card-subtitle {
        font-size: 13px;
        color: #b3b3b3;
        margin: 8px 0 0 0;
    }

    .prem-divider {
        border: none;
        height: 1px;
        background: #2f2f2f;
        margin: 24px 0;
    }

    .prem-card-highlight .prem-divider {
        background: rgba(30, 215, 96, 0.25);
    }

    .prem-features {
        list-style: none;
        padding: 0;
        margin: 0 0 36px 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
        font-size: 15px;
        line-height: 1.4;
    }

    .prem-features li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .check-icon {
        color: #1ed760;
        font-weight: bold;
        font-size: 18px;
        line-height: 1;
    }

    .warn-icon {
        color: #727272;
        font-weight: bold;
        font-size: 16px;
        line-height: 1.1;
    }

    .btn-free-current {
        display: block;
        width: 100%;
        text-align: center;
        background: transparent;
        color: #ffffff;
        border: 2px solid #727272;
        border-radius: 9999px;
        padding: 14px 0;
        font-weight: 800;
        font-size: 15px;
        letter-spacing: 1px;
        cursor: pointer;
        text-transform: uppercase;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-free-current:hover {
        border-color: #ffffff;
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
    }

    .btn-premium-cta {
        display: block;
        width: 100%;
        text-align: center;
        background: #1ed760;
        color: #000000;
        border: none;
        border-radius: 9999px;
        padding: 16px 0;
        font-weight: 800;
        font-size: 16px;
        letter-spacing: 1px;
        cursor: pointer;
        text-transform: uppercase;
        box-shadow: 0 8px 24px rgba(30, 215, 96, 0.3);
        transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
        text-decoration: none;
    }

    .btn-premium-cta:hover {
        background: #1fdf64;
        transform: scale(1.03);
        box-shadow: 0 12px 32px rgba(30, 215, 96, 0.45);
    }

    /* Step 2 & 3 Checkout Panels */
    .prem-step-panel {
        width: 100%;
        max-width: 720px;
        background: #181818;
        border: 1px solid #2a2a2a;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
        display: none; /* Controlled by JS and explicit IDs */
    }

    .payment-step {
        display: none; /* Fail-safe default */
    }

    .payment-step.active {
        display: block;
    }

    /* Method selector */
    .methods-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin: 24px 0;
    }

    .method-card-btn {
        background: #222222;
        border: 2px solid #333333;
        border-radius: 14px;
        padding: 20px 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .method-card-btn:hover {
        background: #2a2a2a;
        border-color: #1ed760;
        transform: translateY(-3px);
    }

    .method-card-btn.selected, .method-card.selected {
        background: rgba(30, 215, 96, 0.1);
        border-color: #1ed760;
        box-shadow: 0 0 0 1px #1ed760;
    }

    @@media (max-width: 768px) {
        .prem-cards-grid {
            grid-template-columns: 1fr;
        }
        .prem-title-headline {
            font-size: 28px;
        }
    }
</style>

<div class="prem-page-shell">
    <!-- Top Navigation Header -->
    <header class="prem-nav-header">
        <a href="/" class="prem-logo">
            💎 <span>Spotifake</span> Premium
        </a>
        <a href="/" class="prem-back-btn">
            ← Quay lại Player
        </a>
    </header>

    <div style="width: 100%; display: flex; flex-direction: column; align-items: center;">
        
        <!-- ==================== VIEW 0: ALREADY PREMIUM (Dành cho user đã có gói) ==================== -->
        <div id="alreadyPremiumView" style="display:none; width: 100%; max-width: 760px;">
            <div class="prem-step-panel" style="display: block; text-align: center; border-color: #1ed760;">
                <div style="font-size: 72px; margin-bottom: 12px;">👑</div>
                <h2 style="font-size: 32px; color: #1ed760; margin: 0 0 12px;">Bạn đang sở hữu Spotifake Premium!</h2>
                <p style="font-size: 16px; color: #b3b3b3; margin-bottom: 24px;">Tận hưởng âm nhạc không giới hạn, không quảng cáo và âm thanh Hi-Res Studio.</p>
                
                <div style="display: inline-block; background: rgba(30,215,96,0.15); border: 1px solid #1ed760; color: #1ed760; padding: 10px 24px; border-radius: 999px; font-weight: 700; font-size: 15px; margin-bottom: 36px;">
                    📅 Hết hạn vào: <span id="premiumExpiryDate">--</span>
                </div>

                <hr style="border:none; height:1px; background:#2a2a2a; margin: 10px 0 28px;">

                <div style="text-align: left;">
                    <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                        <h3 style="font-size: 18px; margin: 0; color: #ffffff;">Lịch sử giao dịch của bạn</h3>
                        <button onclick="loadPaymentHistory('paymentHistoryContainer')" style="background:#282828; border:1px solid #444; color:#fff; padding:6px 16px; border-radius:6px; cursor:pointer; font-size:13px; font-weight:600;">🔄 Tải lại</button>
                    </div>
                    <div id="paymentHistoryContainer">
                        <div style="color:#888; font-size:14px;">Đang tải lịch sử...</div>
                    </div>
                </div>

                <div style="margin-top: 36px;">
                    <a href="/" class="btn-premium-cta" style="max-width: 320px; margin: 0 auto;">🎧 Nghe Nhạc Ngay</a>
                </div>
            </div>
        </div>

        <!-- ==================== FLOW VIEW (Dành cho user Free chưa có gói) ==================== -->
        <div id="paymentFlowView" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
            
            <!-- STEP 1: COMPARISON CARDS (TRANG ĐẦU GIỜI THIỆU TÍNH NĂNG VÀ GIÁ TIỀN) -->
            <div class="payment-step active" id="pmStep1" style="display: block; width: 100%;">
                <h1 class="prem-title-headline">Nghe miễn phí hoặc đăng ký Spotifake Premium.</h1>

                <div class="prem-cards-grid">
                    <!-- FREE CARD -->
                    <div class="prem-card">
                        <div>
                            <h2 class="prem-card-title">Spotifake Free</h2>
                            <div class="prem-card-price">0đ <small>/ tháng</small></div>
                            <p class="prem-card-subtitle">Gói mặc định hoàn toàn miễn phí cho tất cả thính giả.</p>
                            
                            <hr class="prem-divider">
                            
                            <ul class="prem-features">
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span>Phát trộn bài và khám phá playlist</span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span>Nghe trực tuyến với chất lượng âm thanh tiêu chuẩn</span>
                                </li>
                                <li>
                                    <span class="warn-icon">✕</span>
                                    <span style="color: #a0a0a0;">Có kèm quảng cáo âm thanh & hình ảnh giữa các bài hát</span>
                                </li>
                                <li>
                                    <span class="warn-icon">✕</span>
                                    <span style="color: #a0a0a0;">Giới hạn số lượt chuyển và bỏ qua bài hát</span>
                                </li>
                            </ul>
                        </div>
                        
                        <a href="/" class="btn-free-current" onclick="alert('Bạn đang ở gói Spotifake Free. Vui lòng thử nút bên cạnh để Nâng cấp!'); return false;">
                            DÙNG FREE
                        </a>
                    </div>

                    <!-- PREMIUM CARD -->
                    <div class="prem-card prem-card-highlight">
                        <div>
                            <h2 class="prem-card-title" style="color: #1ed760; display: flex; align-items: center; justify-content: space-between;">
                                <span>Spotifake Premium</span>
                                <span style="font-size: 20px;">👑</span>
                            </h2>
                            <div class="prem-card-price">18.000đ <small>/ tháng</small></div>
                            <p class="prem-card-subtitle">Bắt đầu 30 ngày dùng dịch vụ chất lượng cao của bạn*</p>
                            
                            <hr class="prem-divider">
                            
                            <ul class="prem-features">
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Phát trộn bài</strong> & Trí Tuệ Nhân Tạo AI gợi ý nhạc chuẩn xác</span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Không có quảng cáo</strong> — Nghe nhạc xuyên suốt tuyệt đỉnh</span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Số lần bỏ qua bài không giới hạn</strong></span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Nghe offline & âm thanh Studio Hi-Res 320kbps/Lossless</strong></span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Phát bất kỳ bài hát nào</strong> theo đúng yêu cầu tức thì</span>
                                </li>
                                <li>
                                    <span class="check-icon">✓</span>
                                    <span><strong>Huy hiệu Vàng Premium VIP</strong> nổi bật trên Profile</span>
                                </li>
                            </ul>
                        </div>

                        <button type="button" class="btn-premium-cta" onclick="pmGoToStep(2)">
                            DÙNG PREMIUM
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 2: PAYMENT METHOD & OTP (TRANG THANH TOÁN) -->
            <div class="payment-step prem-step-panel" id="pmStep2">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
                    <div>
                        <h2 style="font-size: 26px; font-weight: 800; margin: 0 0 6px;">Thanh toán Gói Premium</h2>
                        <div style="color: #a0a0a0; font-size: 15px;">
                            Tổng thanh toán: <strong style="color: #1ed760; font-size: 18px;">18.000 VND</strong> (30 ngày)
                        </div>
                    </div>
                    <button type="button" class="prem-back-btn" style="padding: 6px 14px; font-size: 12px;" onclick="pmGoToStep(1)">
                        ← Chọn gói khác
                    </button>
                </div>

                <hr style="border:none; height:1px; background:#2a2a2a; margin: 0 0 24px;">

                <label style="display:block; font-weight: 700; font-size: 16px; margin-bottom: 16px;">1. Chọn cổng thanh toán mong muốn:</label>
                
                <div class="methods-grid">
                    <div class="method-card-btn method-card" id="mc-Momo" onclick="pmSelectMethod('Momo')">
                        <div style="font-size: 36px; margin-bottom: 8px;">📱</div>
                        <div style="font-weight: 700; font-size: 16px;">Ví MoMo</div>
                        <div style="font-size: 12px; color: #888; margin-top: 4px;">Quét mã MoMo QR</div>
                    </div>
                    <div class="method-card-btn method-card" id="mc-VNPay" onclick="pmSelectMethod('VNPay')">
                        <div style="font-size: 36px; margin-bottom: 8px;">🏦</div>
                        <div style="font-weight: 700; font-size: 16px;">Cổng VNPay</div>
                        <div style="font-size: 12px; color: #888; margin-top: 4px;">QR Code & Thẻ ATM</div>
                    </div>
                    <div class="method-card-btn method-card" id="mc-Thẻ nội địa" onclick="pmSelectMethod('Thẻ nội địa')">
                        <div style="font-size: 36px; margin-bottom: 8px;">💳</div>
                        <div style="font-weight: 700; font-size: 16px;">Thẻ Ngân Hàng</div>
                        <div style="font-size: 12px; color: #888; margin-top: 4px;">Chuyển khoản NH 24/7</div>
                    </div>
                </div>

                <!-- Section thông tin chuyển khoản & nhập OTP -->
                <div id="pmTransferContainer" style="display: none; margin-top: 32px; border-top: 1px solid #2a2a2a; padding-top: 28px;">
                    <label style="display:block; font-weight: 700; font-size: 16px; margin-bottom: 16px;">2. Thông tin xác nhận giao dịch:</label>
                    
                    <div id="pmTransferBox" style="background: #101010; border: 1px solid #2a2a2a; border-radius: 12px; padding: 20px; font-size: 14px;"></div>

                    <div id="pmOtpBox" style="display: none; background: rgba(30, 215, 96, 0.08); border: 2px dashed #1ed760; border-radius: 14px; padding: 22px; text-align: center; margin: 24px 0;">
                        <div style="font-size: 12px; font-weight: 800; color: #1ed760; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;">🔐 MÃ XÁC THỰC MÔ PHỎNG (DEMO OTP)</div>
                        <div style="font-size: 13px; color: #ffbc42; margin-bottom: 12px;">⚠️ Hãy nhập đúng 6 chữ số hiển thị dưới đây để hoàn tất thanh toán:</div>
                        <div id="pmOtpCode" style="font-size: 48px; font-weight: 900; letter-spacing: 12px; color: #ffffff; font-family: monospace; text-shadow: 0 0 16px rgba(30, 215, 96, 0.6);">------</div>
                    </div>

                    <div id="pmOtpInputGroup" hidden style="margin-top: 20px;">
                        <label for="pmOtpInput" style="display:block; font-weight:700; font-size:15px; text-align:center; margin-bottom:12px;">Nhập mã OTP (6 chữ số) vào đây:</label>
                        <input type="text" id="pmOtpInput" maxlength="6" placeholder="••••••" 
                               style="display:block; width: 100%; max-width: 340px; margin: 0 auto; padding: 14px; background: #080808; border: 2px solid #333; border-radius: 12px; color: #fff; font-size: 32px; font-weight: 800; text-align: center; letter-spacing: 14px; font-family: monospace; outline: none; transition: border-color 0.2s;">
                    </div>

                    <div id="pmStep2Error" style="display: none; background: #3c1418; border: 1px solid #f85149; color: #ffb4bf; padding: 14px; border-radius: 10px; margin-top: 18px; text-align: center; font-size: 14px; font-weight: 600;"></div>

                    <div style="display: flex; gap: 16px; margin-top: 32px;">
                        <button type="button" onclick="pmGoToStep(1)" style="flex: 1; background: #2a2a2a; color: #fff; border: 1px solid #444; padding: 16px; border-radius: 999px; font-weight: 700; font-size: 15px; cursor: pointer;">
                            ← Quay lại
                        </button>
                        <button type="button" id="pmConfirmBtn" onclick="pmConfirmPayment()" disabled 
                                style="flex: 2; background: #1ed760; color: #000; border: none; padding: 16px; border-radius: 999px; font-weight: 800; font-size: 16px; cursor: pointer; box-shadow: 0 8px 24px rgba(30,215,96,0.35); transition: all 0.2s;">
                            ✅ Xác Nhận Thanh Toán
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 3: RECEIPT & SUCCESS (TRANG THÀNH CÔNG) -->
            <div class="payment-step prem-step-panel" id="pmStep3" style="border-color: #1ed760;">
                <div style="text-align: center; margin-bottom: 28px;">
                    <div style="font-size: 72px; margin-bottom: 12px;">🎉</div>
                    <h2 style="font-size: 30px; font-weight: 900; color: #1ed760; margin: 0 0 8px;">Thanh toán thành công!</h2>
                    <p style="font-size: 16px; color: #b3b3b3;">Chúc mừng tài khoản của bạn đã chính thức được nâng cấp lên Spotifake Premium VIP.</p>
                </div>

                <!-- Thẻ Biên Lai -->
                <div style="background: #111111; border: 1px solid #282828; border-radius: 16px; overflow: hidden; margin-bottom: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                    <div style="background: #1a2c20; padding: 20px 24px; border-bottom: 1px solid #1ed760; display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 28px;">👑</span>
                            <div>
                                <div style="font-weight: 800; font-size: 18px; color: #fff;">Biên Lai Giao Dịch</div>
                                <div style="font-size: 12px; color: #1ed760; font-weight: 600;">STATUS: SUCCESS (ĐÃ THANH TOÁN)</div>
                            </div>
                        </div>
                        <div style="font-size: 24px; font-weight: 900; color: #1ed760;">18.000đ</div>
                    </div>
                    <div id="pmReceiptBody" style="padding: 24px;"></div>
                </div>

                <div style="text-align: center; margin-bottom: 36px;">
                    <a href="/" class="btn-premium-cta" style="max-width: 360px; margin: 0 auto;">
                        🎧 TRẢI NGHIỆM PREMIUM NGAY BÂY GIỜ
                    </a>
                </div>

                <hr style="border:none; height:1px; background:#2a2a2a; margin: 28px 0;">

                <div>
                    <h3 style="font-size: 18px; font-weight: 700; color: #ffffff; margin: 0 0 16px;">Lịch sử giao dịch của bạn</h3>
                    <div id="pmReceiptHistory"></div>
                </div>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set focus formatting for OTP input
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof window.initPremiumSection === 'function') {
                window.initPremiumSection();
            }
            const otpIn = document.getElementById('pmOtpInput');
            if (otpIn) {
                otpIn.addEventListener('focus', () => otpIn.style.borderColor = '#1ed760');
                otpIn.addEventListener('blur', () => otpIn.style.borderColor = '#333');
            }
        });
    </script>
}
